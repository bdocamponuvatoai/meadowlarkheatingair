# Copy to .env.local for local overrides. Never commit real .env files.

# Public origin of the site, used for canonical URLs, Open Graph, robots.txt and
# sitemap.xml. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL, and
# locally to http://localhost:3000.
SITE_URL=https://www.example.com

# "true" lets search engines index the site (robots meta, robots.txt, sitemap).
# Leave false until the business owner approves the launch. The build fails if
# this is true while SITE_URL is unset.
SITE_INDEXABLE=false
